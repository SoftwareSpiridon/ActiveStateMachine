<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageReference Include="Stateless" Version="5.15.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Behavioral tests run against the generated PhoneActiveObject in both examples. -->
    <ProjectReference Include="..\..\samples\ActiveStateMachine.Example.Async\ActiveStateMachine.Example.Async.csproj" />
    <ProjectReference Include="..\..\samples\ActiveStateMachine.Example.Sync\ActiveStateMachine.Example.Sync.csproj" />
    <!--
      The generator is referenced two ways: as a normal assembly so the diagnostic tests can
      instantiate ActiveObjectGenerator, and as an analyzer so it runs on this project's own source
      (the 'Boom' fixture in SyncPhoneActiveObjectTests relies on the generated members).
    -->
    <ProjectReference Include="..\..\src\ActiveStateMachine.Generators\ActiveStateMachine.Generators.csproj"
                      OutputItemType="Analyzer" />
  </ItemGroup>

</Project>
