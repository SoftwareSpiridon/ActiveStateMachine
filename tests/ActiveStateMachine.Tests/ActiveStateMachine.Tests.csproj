<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageReference Include="Stateless" Version="5.15.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Behavioral tests run against the generated PhoneActiveObject. -->
    <ProjectReference Include="..\..\samples\ActiveStateMachine.Example\ActiveStateMachine.Example.csproj" />
    <!-- Diagnostic tests drive the generator directly. -->
    <ProjectReference Include="..\..\src\ActiveStateMachine.Generators\ActiveStateMachine.Generators.csproj" />
  </ItemGroup>

</Project>
