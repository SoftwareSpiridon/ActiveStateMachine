<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- ===================== NuGet package ===================== -->
    <!--
      This project is the primary package. It ships:
        * its own marker attributes assembly in lib/netstandard2.0  (referenced normally)
        * the source generator in analyzers/dotnet/cs               (loaded as a Roslyn analyzer)
        * a dependency on Stateless                                 (needed by the generated code)
      so a single <PackageReference Include="ActiveStateMachine" /> is all a consumer needs.
    -->
    <IsPackable>true</IsPackable>
    <PackageId>ActiveStateMachine</PackageId>
    <Title>ActiveStateMachine — Active Object source generator for Stateless</Title>
    <Description>A Roslyn incremental source generator that turns a partial class into a fully thread-safe, lock-free Active Object around a Stateless state machine. Decorate a class with [ActiveObject] and declare partial Task methods with [StateTrigger]; the generator emits the Channel-based mailbox, the single worker loop, the message records, the constructor and async disposal. Includes the marker attributes and depends on Stateless.</Description>
    <PackageReleaseNotes>Initial release: [ActiveObject]/[StateTrigger] attributes, incremental generator, 0-3 parameter triggers, async disposal, and ASM001-ASM005 diagnostics.</PackageReleaseNotes>

    <!-- Ship XML docs for IntelliSense on the marker attributes. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Emit a .snupkg symbol package alongside the main package. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The generated code references Stateless, so consumers must have it. Flowing it as a
      package dependency means one PackageReference to ActiveStateMachine pulls it in.
    -->
    <PackageReference Include="Stateless" Version="5.15.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Reference the generator project only to force it to build BEFORE this project (so its
      DLL exists at pack time). ReferenceOutputAssembly=false keeps it out of this assembly's
      compile references, and PrivateAssets=all keeps it from becoming a package dependency.
    -->
    <ProjectReference Include="..\ActiveStateMachine.Generators\ActiveStateMachine.Generators.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundle the built generator into the package as a Roslyn analyzer. -->
    <None Include="..\ActiveStateMachine.Generators\bin\$(Configuration)\netstandard2.0\ActiveStateMachine.Generators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />

    <!-- Ship the README as the package landing page on nuget.org. -->
    <None Include="..\..\README.md"
          Pack="true"
          PackagePath="\"
          Visible="false" />
  </ItemGroup>

</Project>
